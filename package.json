{
  "name": "eval-llm-gate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An agent playground and behavioral evaluation workspace.",
  "scripts": {
    "dev": "pnpm --parallel --filter @gate/api --filter @gate/web dev",
    "dev:agent": "pnpm --filter @gate/agent dev",
    "eval": "pnpm --filter @gate/evals eval",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
